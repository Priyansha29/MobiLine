# IVGuard dashboard environment configuration
#
# Base address of the ESP32 prototype. The dashboard polls <VITE_API_BASE>/data.
# Copy this file to `.env.local` and set the IP printed in the ESP32 Serial
# Monitor, for example:
#
#   VITE_API_BASE=http://192.168.4.1
#
# Leave it empty/absent to start in the "NOT CONFIGURED" state. The dashboard
# never substitutes mock data when the hardware is unavailable.
VITE_API_BASE=